# Copy file này thành .env ở thư mục gốc của bot rồi điền giá trị.
# Bot tự nạp .env khi khởi động (src/env.js) — KHÔNG cần cờ --env-file-if-exists.
# Biến đã khai báo trong panel host / terminal LUÔN thắng giá trị trong file này.
# Lưu dạng UTF-8 (có BOM vẫn đọc được), tránh UTF-16.
#
# ---------- Zalo Bot ----------
# Token lấy từ Zalo Bot Creator (tin nhắn Zalo gửi cho bạn).
ZALO_BOT_TOKEN=
# ID bot (tuỳ chọn, dùng để kiểm tra token có đúng bot không).
ZALO_BOT_ID=
# Rỗng = cho phép mọi chat. Nên điền chat.id của group sau lần chạy đầu (xem log hoặc /id).
ALLOWED_CHAT_IDS=
ZALO_BASE_URL=https://bot-api.zaloplatforms.com
# markdown | none
ZALO_PARSE_MODE=markdown
# polling (chạy local, không cần tunnel) | webhook (cần HTTPS công khai)
MODE=polling
# Chỉ bind localhost; tunnel (cloudflared/ngrok) vẫn hoạt động
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8787
WEBHOOK_PATH=/zalo/webhook
# URL HTTPS công khai (ngrok/cloudflared) để tự gọi setWebhook
WEBHOOK_PUBLIC_URL=
# >= 8 ký tự. Bỏ trống ở MODE=webhook → sinh 1 lần và lưu ở data/webhook-secret
# (restart không đổi secret nên không bị 403)
WEBHOOK_SECRET=

# ---------- NVIDIA NIM ----------
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# Model lớn nhất của dòng Nemotron 3 (550B, MoE A55B) — chọn trong chat bằng /model ultra
NIM_ULTRA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Model dự phòng khi model chính lỗi/timeout (để trống = tắt)
NIM_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# none | low | medium | high | auto
NIM_REASONING=none
# 0 hoặc để trống = không giới hạn max_tokens (model sinh tới khi xong).
NIM_MAX_TOKENS=
NIM_TEMPERATURE=0.6
NIM_TIMEOUT_MS=15000
# Ngân sách thời gian cho 1 câu trả lời (ms)
RESPONSE_TIMEOUT_MS=30000

# ---------- DeepSeek (model chính) ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Tên model thật của API: deepseek-flash (V4.1 Flash) và deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_TEMPERATURE=0.6
DEEPSEEK_TIMEOUT_MS=15000

# ---------- Chọn model ----------
# deepseek | pro | nim | nim-light   (trong chat đổi bằng /model <alias>)
MODEL_DEFAULT=deepseek
MODEL_FALLBACK=nim-light
# none (tắt suy nghĩ) | low | medium | high | auto
# NIM_REASONING vẫn được nhận như tên cũ của biến này
AI_REASONING=none

# ---------- Context ----------
# 0 = không giới hạn
CONTEXT_MAX_TOKENS=0
CONTEXT_MAX_MESSAGES=0
# 0 = không cắt ký tự trong 1 tin khi gửi model
CONTEXT_MAX_CHARS_PER_MESSAGE=12000
# Số giờ giữ context của một chat không hoạt động. 0 = không bao giờ tự xoá.
# 720 = 30 ngày; đặt 0 nếu muốn giữ mãi (tự backup vẫn nên làm).
CONTEXT_TTL_HOURS=720
CONTEXT_SUMMARY=on
# ---------- Compaction ----------
# 0 = chưa biết context window → chỉ nén khi provider báo tràn context.
# Đặt số thật (vd 128000) để nén sớm theo áp lực token.
CONTEXT_MODEL_WINDOW=0
# Nén khi prompt ước lượng vượt tỉ lệ này của context window (0 < x <= 1).
CONTEXT_COMPACT_THRESHOLD=0.8
# Số message gần nhất giữ lại khi tóm tắt phần cũ.
CONTEXT_KEEP_RECENT=8
CONTEXT_SUMMARY_MAX_CHARS=1200
# Tool result cũ dài hơn số ký tự này sẽ bị rút gọn trước khi tóm tắt.
CONTEXT_TOOL_RESULT_KEEP_CHARS=600
# Model là text-only: ảnh người dùng gửi chỉ được ghi chú, không gửi nội dung ảnh lên API.
# Thư mục dữ liệu (context, sticker, webhook secret).
# Tương đối → tính từ GỐC REPO, không phải cwd lúc khởi động.
# Trên panel/hosting: dùng đường dẫn tuyệt đối tới volume persistent.
# TUYỆT ĐỐI không dùng /tmp (mất mỗi lần restart/redeploy).
DATA_DIR=./data

# ---------- Tavily web search ----------
SEARCH_ENABLED=on
# off = model không tự gọi web_search; /search vẫn dùng được
SEARCH_AUTO=on
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
SEARCH_DEPTH=fast
SEARCH_MAX_RESULTS=4
SEARCH_COUNTRY=vietnam
# Cache kết quả search (ms); 0 = tắt cache
SEARCH_CACHE_TTL_MS=600000

# ---------- Hành vi ----------
IMAGE_ENABLED=on
# Gửi sticker qua /sticker hoặc tool send_sticker
STICKER_ENABLED=on
# Trả lại đúng sticker khi có người gửi sticker cho bot
STICKER_ECHO=on
# Sticker ID chính thức (20 hex), khai báo sẵn: id1,id2:tên hai
# ID mẫu trong docs Zalo Bot (đã kiểm chứng gửi được): 0e078a2fb66a5f34067b
# Admin cũng có thể thêm trực tiếp trong chat: /sticker add <id> [tên]
STICKER_IDS=
# hard (mặc định) = nặng | extreme = gắt nhất (nên dùng /tone max) | roast = vừa | friendly = lịch sự
# alias: max/extreme/cuc → roast-extreme, hard/nang → roast-hard, cay → roast
BOT_TONE=hard
TYPING=on
# refresh "đang soạn tin" mỗi N ms (Zalo tự hết hạn indicator, đừng để quá lâu)
TYPING_INTERVAL_MS=4000
# auto (chỉ tách khi chờ > PROGRESSIVE_AFTER_MS) | on (tách sớm) | off
PROGRESSIVE=auto
PROGRESSIVE_AFTER_MS=3000
# 0 = gửi hết câu trả lời, không giới hạn số tin
MAX_MESSAGES_PER_REPLY=0
# Số tin tối đa đang chờ trong queue trước khi bỏ bớt (tránh quá tải)
MAX_QUEUE_DEPTH=50
# Số tin tối đa một người được gửi mỗi phút (0 = tắt) — chặn spam đốt credit API
USER_RATE_LIMIT_PER_MINUTE=12
# Zalo user id được dùng /reset, /think trong group (phân tách bằng dấu phẩy)
ADMIN_IDS=
# pretty (màu + icon) | json (để máy đọc / ghi log file)
LOG_FORMAT=pretty
# auto | always | never
LOG_COLOR=auto
LOG_LEVEL=info
# on = in "thinking" (reasoning_content) của model ra console.
# Chỉ có nội dung khi AI_REASONING khác none (low|medium|high|auto).
LOG_THINKING=on
# Tuỳ chọn: mở /healthz + /metrics trên port này
OPS_PORT=
