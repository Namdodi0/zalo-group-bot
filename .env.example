# Copy this file to .env in the bot's root directory, then fill in the values.
# The bot loads .env itself on startup (src/env.js) — NO need for the --env-file-if-exists flag.
# Variables already declared in the host panel / terminal ALWAYS win over the values in this file.
# Save as UTF-8 (a BOM is still readable), avoid UTF-16.
#
# ---------- Zalo Bot ----------
# Token from Zalo Bot Creator (the Zalo message sent to you).
ZALO_BOT_TOKEN=
# Bot ID (optional, used to check the token belongs to the right bot).
ZALO_BOT_ID=
# Empty = allow every chat. Fill in the group's chat.id after the first run (see the log or /id).
ALLOWED_CHAT_IDS=
ZALO_BASE_URL=https://bot-api.zaloplatforms.com
# markdown | none
ZALO_PARSE_MODE=markdown
# polling (run locally, no tunnel needed) | webhook (needs public HTTPS)
MODE=polling
# Only binds localhost; a tunnel (cloudflared/ngrok) still works
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8787
WEBHOOK_PATH=/zalo/webhook
# Public HTTPS URL (ngrok/cloudflared) so the bot can call setWebhook itself
WEBHOOK_PUBLIC_URL=
# >= 8 characters. Left empty with MODE=webhook → generated once and stored in data/webhook-secret
# (restarts keep the same secret, so you don't get 403)
WEBHOOK_SECRET=

# ---------- NVIDIA NIM ----------
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# Largest model in the Nemotron 3 line (550B, MoE A55B) — pick it in chat with /model ultra
NIM_ULTRA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Fallback model when the primary model fails/times out (leave empty = disabled)
NIM_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# none | low | medium | high | auto
NIM_REASONING=none
# 0 or empty = unlimited max_tokens (the model generates until it is done).
NIM_MAX_TOKENS=
NIM_TEMPERATURE=0.6
# 0 = no request timeout (wait for the provider as long as it needs)
NIM_TIMEOUT_MS=0
# 0 = no deadline for one answer (the bot waits instead of apologising)
RESPONSE_TIMEOUT_MS=0

# ---------- DeepSeek (primary model) ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Real API model names: deepseek-flash (V4.1 Flash) and deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_TEMPERATURE=0.6
# 0 = no request timeout
DEEPSEEK_TIMEOUT_MS=0

# ---------- Model selection ----------
# deepseek | pro | nim | nim-light   (switch in chat with /model <alias>)
MODEL_DEFAULT=deepseek
MODEL_FALLBACK=nim-light
# If the fallback provider has no API key, that alias is skipped and the bot picks another
# available model (or runs without a fallback) instead of refusing to start.
# none (thinking off) | low | medium | high | auto
# NIM_REASONING is still accepted as the old name for this variable
AI_REASONING=none

# ---------- Context ----------
# 0 = unlimited
CONTEXT_MAX_TOKENS=0
CONTEXT_MAX_MESSAGES=0
# 0 = do not truncate characters inside a message sent to the model
CONTEXT_MAX_CHARS_PER_MESSAGE=12000
# Number of hours to keep an inactive chat's context. 0 = never auto-delete.
# 720 = 30 days; set 0 to keep it forever (you should still back up yourself).
CONTEXT_TTL_HOURS=720
CONTEXT_SUMMARY=on
# ---------- Compaction ----------
# 0 = context window unknown → only compact when the provider reports context overflow.
# Set a real number (e.g. 128000) to compact early under token pressure.
CONTEXT_MODEL_WINDOW=0
# Compact when the estimated prompt exceeds this ratio of the context window (0 < x <= 1).
CONTEXT_COMPACT_THRESHOLD=0.8
# Number of most recent messages kept when summarizing the older part.
CONTEXT_KEEP_RECENT=8
CONTEXT_SUMMARY_MAX_CHARS=1200
# Tool results longer than this many characters are shrunk before summarizing.
CONTEXT_TOOL_RESULT_KEEP_CHARS=600
# The model is text-only: images sent by users are only noted, image content is never sent to the API.
# Data directory (context, stickers, webhook secret).
# Relative → resolved from the REPO ROOT, not the cwd at startup.
# On a panel/host: use an absolute path to a persistent volume.
# NEVER use /tmp (it disappears on every restart/redeploy).
DATA_DIR=./data

# ---------- Tavily web search ----------
SEARCH_ENABLED=on
# off = the model never calls web_search on its own; /search still works
SEARCH_AUTO=on
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
SEARCH_DEPTH=fast
SEARCH_MAX_RESULTS=4
SEARCH_COUNTRY=vietnam
# Search result cache (ms); 0 = disable cache
SEARCH_CACHE_TTL_MS=600000

# ---------- Behavior ----------
IMAGE_ENABLED=on
# Send stickers via /sticker or the send_sticker tool
STICKER_ENABLED=on
# Echo the exact sticker back when someone sends a sticker to the bot
STICKER_ECHO=on
# Official sticker ID (20 hex), declared up front: id1,id2:name two
# Sample ID from the Zalo Bot docs (verified to send): 0e078a2fb66a5f34067b
# Admins can also add them directly in chat: /sticker add <id> [name]
STICKER_IDS=
# hard (default) = heavy | extreme = harshest (use /tone max) | roast = medium | friendly = polite
# aliases: max/extreme/cuc → roast-extreme, hard/nang → roast-hard, cay → roast
BOT_TONE=hard
TYPING=on
# refresh "typing" every N ms (Zalo expires the indicator itself, don't leave it too long)
TYPING_INTERVAL_MS=4000
# auto (only split when the wait is > PROGRESSIVE_AFTER_MS) | on (split early) | off
PROGRESSIVE=auto
PROGRESSIVE_AFTER_MS=3000
# 0 = send the whole answer, no limit on the number of messages
MAX_MESSAGES_PER_REPLY=0
# Maximum number of messages waiting in the queue before dropping the rest (avoids overload)
MAX_QUEUE_DEPTH=50
# Maximum number of messages one person may send per minute (0 = off) — stops spam burning API credit
USER_RATE_LIMIT_PER_MINUTE=12
# Zalo user ids allowed to use /reset, /think in the group (comma separated)
ADMIN_IDS=
# pretty (color + icons) | json (machine readable / log to file)
LOG_FORMAT=pretty
# auto | always | never
LOG_COLOR=auto
LOG_LEVEL=info
# on = print the model's "thinking" (reasoning_content) to the console.
# Only has content when AI_REASONING is not none (low|medium|high|auto).
LOG_THINKING=on
# Optional: expose /healthz + /metrics on this port
OPS_PORT=
