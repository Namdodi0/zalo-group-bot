[Unit]
Description=Zalo group bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zalobot
Group=zalobot
WorkingDirectory=/opt/zalo/zalo-group-bot
ExecStart=/usr/bin/node --env-file-if-exists=.env src/index.js
Restart=always
RestartSec=5
# Nếu bot bị đẩy vào swap do context phình to
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
