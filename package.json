{
  "name": "zalo-group-bot",
  "version": "1.1.3",
  "private": true,
  "type": "module",
  "description": "Zalo group chatbot powered by NVIDIA NIM (Nemotron 3.5 Super VL) + Tavily web search",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "webhook": "node src/index.js --mode webhook",
    "smoke": "node scripts/smoke.js",
    "simulate": "node scripts/simulate.js",
    "pack": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pack.ps1",
    "test": "node --test",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
